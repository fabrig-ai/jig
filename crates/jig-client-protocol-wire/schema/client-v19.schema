enum OwnerTaskCapacityAction { batch: OwnerTaskCapacityActionBatch, proposal: OwnerTaskCapacityActionProposal, person_proposal: OwnerTaskCapacityActionPersonProposal, message: OwnerTaskCapacityActionMessage, source: OwnerTaskCapacityActionSource, introduce: OwnerTaskCapacityActionIntroduce, subscription: OwnerTaskCapacityActionSubscription, effect: OwnerTaskCapacityActionEffect, claim: OwnerTaskCapacityActionClaim, release, move_task, place: OwnerTaskCapacityActionPlace }
