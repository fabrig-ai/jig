record OwnerTaskCapacityCauseResourceReports { limit: u32 }
record OwnerTaskCapacityCauseProjectTasks { limit: u32 }
record OwnerTaskCapacityCauseTree { limit: u32 }
record OwnerTaskCapacityCauseDelegates { limit: u32 }
record OwnerTaskCapacityCauseInbox { task: u64 messages: u32 bytes: u32 }
record OwnerTaskCapacityCauseHoldings { limit: u32 }
record OwnerTaskCapacityCauseHoldWaiters { limit: u32 }
record OwnerTaskCapacityCauseProposals { limit: u32 }
record OwnerTaskCapacityCauseReferences { limit: u32 }
record OwnerTaskCapacityCauseSubscriptions { limit: u32 }
record OwnerTaskCapacityCauseFunders { limit: u32 }
record OwnerTaskCapacityCauseWriters { limit: u32 }
record OwnerTaskCapacityCausePlacedHolds { limit: u32 }
record OwnerTaskCapacityCauseProjectPlacedHolds { limit: u32 }
record OwnerTaskCapacityCausePartyPlacedHolds { limit: u32 }
record OwnerTaskCapacityCauseExemptions { limit: u32 }
enum OwnerTaskCapacityCause { tasks: OwnerTaskCapacityCauseTasks, creation_flights: OwnerTaskCapacityCauseCreationFlights, resource_reports: OwnerTaskCapacityCauseResourceReports, project_tasks: OwnerTaskCapacityCauseProjectTasks, tree: OwnerTaskCapacityCauseTree, delegates: OwnerTaskCapacityCauseDelegates, inbox: OwnerTaskCapacityCauseInbox, holdings: OwnerTaskCapacityCauseHoldings, hold_waiters: OwnerTaskCapacityCauseHoldWaiters, proposals: OwnerTaskCapacityCauseProposals, references: OwnerTaskCapacityCauseReferences, subscriptions: OwnerTaskCapacityCauseSubscriptions, funders: OwnerTaskCapacityCauseFunders, writers: OwnerTaskCapacityCauseWriters, placed_holds: OwnerTaskCapacityCausePlacedHolds, project_placed_holds: OwnerTaskCapacityCauseProjectPlacedHolds, party_placed_holds: OwnerTaskCapacityCausePartyPlacedHolds, exemptions: OwnerTaskCapacityCauseExemptions }
record OwnerTaskCapacityRequest { project: option u32 by: OwnerRequester action: OwnerTaskCapacityAction cause: OwnerTaskCapacityCause }
record OwnerTaskCapacityRefusal { request: OwnerTaskCapacityRequest at: u64 }
enum WatchEnd { not_served: NotServed, closed, unknown, not_allowed, busy, subject_ended, signed_out, stopping }
enum WatchRefusal { unknown, not_allowed, busy, signed_out }
record Open { stream: fixed 16 watch: u64 subject: Owned }
record OpenAnswerRefused { why: WatchRefusal }
enum OpenAnswer { not_served: NotServed, admitted, refused: OpenAnswerRefused }
record WatchClose { stream: fixed 16 watch: u64 }
enum CloseAnswer { closed, signed_out }
record Gone { stream: fixed 16 }
record Hello { stream: fixed 16 served: list 16 Served heartbeat: duration }
record Delivery { watch: u64 document: Owned }
record Ended { watch: u64 why: WatchEnd }
record StreamText { watch: u64 value: RunText }
enum StreamEvent { hello: Hello, delivery: Delivery, text: StreamText, ended: Ended }
record OwnerAccountStateLater { until: option u64 }
enum OwnerAccountPlace { directory, file }
enum OwnerAccountUnread { unreadable, refused, failed, stalled, too_large }
record OwnerAccountStateUnloaded { at: OwnerAccountPlace why: OwnerAccountUnread }
enum OwnerAccountState { asking, granted, later: OwnerAccountStateLater, sign_in_again, misconfigured, unloaded: OwnerAccountStateUnloaded, cancelled, closing, moving }
record OwnerAccountUseParty { party: u64 }
record OwnerAccountUseProject { project: u32 }
enum OwnerAccountUse { party: OwnerAccountUseParty, project: OwnerAccountUseProject }
record PayerReadiness { provider: u32 payer: OwnerAccountUse readiness: Readiness settled: option bool }
record AccountChangeDeclareProgram { provider: u32 join: option u32 name: bytes 32 }
record AccountChangeCheckProgram { source: u32 }
record AccountChangeAddKey { provider: u32 join: option u32 digest: fixed 32 }
record AccountChangeReplaceKey { source: u32 digest: fixed 32 }
record AccountChangeRemoveKey { source: u32 }
record AccountChangeResume { source: u32 }
record AccountChangeRemove { account: u32 }
record AccountChangeMoveAccount { account: u32 place: u32 }
record AccountChangeMoveSource { account: u32 source: u32 place: u32 }
record AccountChangeSetUses { account: u32 uses: option list 16 OwnerAccountUse }
record AccountChangeMoveOut { account: u32 }
record AccountChangeWritten { number: u32 }
record AccountChangeMoveIn { digest: fixed 32 }
record AccountChangeFinishSignIn { source: u32 digest: fixed 32 }
enum AccountChange { add_key: AccountChangeAddKey, replace_key: AccountChangeReplaceKey, remove_key: AccountChangeRemoveKey, resume: AccountChangeResume, remove: AccountChangeRemove, move_account: AccountChangeMoveAccount, move_source: AccountChangeMoveSource, set_uses: AccountChangeSetUses, declare_program: AccountChangeDeclareProgram, check_program: AccountChangeCheckProgram, move_out: AccountChangeMoveOut, written: AccountChangeWritten, move_in: AccountChangeMoveIn, finish_sign_in: AccountChangeFinishSignIn }
record AskAccountChange { holder: AccountHolder change: AccountChange }
record OwnerAccountHolderParty { party: u64 }
enum OwnerAccountHolder { deployment, party: OwnerAccountHolderParty }
enum OwnerAccountKind { sign_in, key, program, none }
enum OwnerAccountBound { accounts, holder_accounts, sources, sign_ins }
enum OwnerAccountKeyFailure { too_long, not_stored }
