family jig-store-secrets 1

# Credentials, signed-in sources and request-carried values (store.md 9).
# Each bound is its producer's ceiling, checked in the store-codecs world.
versioned record Digest { expiry: u64 digest: fixed 32 }
record SourceRecord { record: secret 274497 holds skein-oauth SavedToken }
record SourceKey { key: secret 131072 }
enum SourceValue { record: SourceRecord, key: SourceKey }
versioned record Source { value: SourceValue }
record CarriedKey { key: secret 131072 }
record CarriedValue { value: secret 131072 }
record CarriedMoved { moved: secret 131072 holds jig-accounts Moved }
enum Carrying { key: CarriedKey, value: CarriedValue, moved: CarriedMoved }
versioned record Carried { value: Carrying }
versioned record NextCarried { next: u64 }
