family jig-store-component 3

record Levels {
    skein: option u32
    smith: option u32
    jig: option u32
    application: option u32
}
record Wire { name: text 32 version: u32 }
versioned record Wires { wires: list 16 Wire }
versioned record Format {
    component: u16
    core: u16
    tasks: u16
    people: u16
    notes: u16
    accounts: u16
    settings: u16
    application: u32
    deployment: fixed 16
    levels: Levels
}
record Count { family: text 64, before: u64, after: u64 }
versioned record Manifest {
    generation: u64
    from: option u64
    before: Levels
    after: Levels
    counts: list 64 Count
    store: u64
    secrets: option u64
    written: u64
}
versioned record Transcript { length: u64 window: u64 }
versioned record Attempt { first: u64 }
versioned record Layouts {
    component: fixed 32
    core: fixed 32
    tasks: fixed 32
    people: fixed 32
    notes: fixed 32
    accounts: fixed 32
    settings: fixed 32
    secrets: fixed 32
    skein_oauth: fixed 32
    smith_transcript: fixed 32
}
