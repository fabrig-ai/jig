family jig-test-client-wire 2
record Segment { bytes: bytes 256 }
record ResourcePath { segments: list 32 Segment }
record Key { attempt: u64 completion: u32 position: u32 deployment: fixed 16 task: u64 purpose: u64 }
record Effect { kind: u16 resources: list 64 ResourcePath purpose: u64 condition: option u64 target: u64 state: u64 }
record Attempt { number: u32 sent: u64 deadline: u64 }
record ProcedureState { project: u32 task: u64 number: u16 resource: ResourcePath index: u16 steps: u16 awaiting: bool deadline: option u64 delegate: option u64 revision: u64 }
record ApplicationObject { revision: u64 value: u64 }
record RefusalRole { held: option u32 }
record RefusalTaken { by: u64 }
record LackAgain { required: bool }
record LackBudget { needs: u64 left: u64 }
record LackGrant { kind: u16 }
record LackDepth { most: u32 }
record LackTasks { left: u32 }
record LackRequired { connector: u16 kind: u16 }
record LackFailed { connector: u16 kind: u16 }
record LackUnguarded { connector: u16 kind: u16 }
enum Lack { approver, again: LackAgain, budget: LackBudget, grant: LackGrant, funding, task_kind, depth: LackDepth, deadline, tasks: LackTasks, tool, scope, reference, resource_access, resource_unavailable, shape, account, writer, required: LackRequired, failed: LackFailed, unguarded: LackUnguarded, models }
enum LimitKind { words, identity, roles, arithmetic, duplicate, empty, batch, project_live_tasks, live_tasks, tree, depth, delegates, subscription, dependencies, cycle, spec, contract, authority, inputs, attempts, live_delegates, restore, read, turn, hold_kind, hold_taken, holds, inbox_full, notes, revision, question, priority, policy, resource, service, placed_holds, project_placed_holds, party_placed_holds, exemptions }
record PartyPerson { value: u64 }
record PartyTask { value: u64 }
record PartyDeployment { project: u32 }
enum Party { person: PartyPerson, task: PartyTask, deployment: PartyDeployment }
record EndingCancelled { by: Party at: u64 }
record EndingDecided { by: u64 at: u64 }
enum Ending { done, failed, cancelled: EndingCancelled, decided: EndingDecided, deleted }
record MovedSpec { revision: u64 }
record MovedPerson { revision: u64 }
record MovedNote { revision: u32 }
record HoldReasonDependency { task: u64 }
record HoldReasonPlaced { hold: u64 }
record HoldReasonUncertain { entry: u64 }
record HoldReasonPoolLost { pool: u64 }
enum FailureClass { transient, permanent, run, agent, lost, invalid }
enum EffectPhase { kept, sent, uncertain, retry, repeat, held }
enum ResourceRole { owned, participating, context, unavailable }
record ApplicationOutcomeChanged { object: u64 now: ApplicationObject }
record ApplicationOutcomeMoved { object: u64 now: ApplicationObject }
record ApplicationOutcomeRole { held: u32 }
record OutboxEntry { number: u64 task: u64 key: Key effect: Effect attempt: option Attempt phase: EffectPhase }
record RefusalAuthority { lacking: Lack proposable: option bool }
record RefusalLimit { which: LimitKind }
record RefusalEnded { how: Ending }
record HoldReasonFailures { class: FailureClass }
enum Bound { reasoning, metadata, items, answer, tools, history_items, history, window, output }
record Exceeded { bound: Bound value: u64 }
enum HoldReason { failures: HoldReasonFailures, stalled, dependency: HoldReasonDependency, stopped, placed: HoldReasonPlaced, drift, effects, effect_failed, uncertain: HoldReasonUncertain, budget, deadline, holds_waited, resource_unavailable, resource_access, pool_lost: HoldReasonPoolLost, procedure, circle, exceeded: Exceeded }
record MovedHold { revision: u64 reason: HoldReason }
enum Moved { hold: MovedHold, spec: MovedSpec, person: MovedPerson, note: MovedNote }
record RefusalMoved { now: Moved }
enum Refusal { role: RefusalRole, authority: RefusalAuthority, limit: RefusalLimit, moved: RefusalMoved, ended: RefusalEnded, taken: RefusalTaken, not_waiting, no_further, unknown, not_offered, key_conflict }
record ApplicationOutcomeCoreRefused { why: Refusal }
enum ApplicationOutcome { changed: ApplicationOutcomeChanged, moved: ApplicationOutcomeMoved, role: ApplicationOutcomeRole, unknown, exhausted, core_refused: ApplicationOutcomeCoreRefused }
record ApplicationRelease { task: u64 revision: u64 again: option bool }
record ApplicationRequest { object: u64 revision: u64 value: option u64 release: option ApplicationRelease }
record ClientSubjectObject { project: u32 object: u64 }
record ClientSubjectPanel { project: u32 task: u64 }
record ClientSubjectResult { project: u32 task: u64 }
record ClientSubjectEffect { project: u32 proposal: u64 }
record ClientSubjectOutbox { project: u32 entry: u64 }
record ClientSubjectHold { project: u32 task: u64 }
record ClientSubjectProject { project: u32 }
enum ClientSubject { object: ClientSubjectObject, panel: ClientSubjectPanel, result: ClientSubjectResult, effect: ClientSubjectEffect, outbox: ClientSubjectOutbox, hold: ClientSubjectHold, project: ClientSubjectProject, deployment }
enum Form { creation, transition, set }
enum Recovery { keyed, conditional, idempotent, unrecoverable }
enum HoldMode { refuse, wait }
record HoldExclusive { mode: HoldMode }
record HoldPooled { mode: HoldMode }
enum Hold { exclusive: HoldExclusive, pooled: HoldPooled, none }
record Fact { state: option u64 observed: u64 pending: bool }
record Description { kind: u16 resources: list 64 ResourcePath purpose: u64 condition: bool form: Form recovery: Recovery price: option u64 state: u64 }
record ClientResource { path: ResourcePath role: ResourceRole hold: Hold fact: option Fact }
enum DiagnosticAvailability { not_kept }
record ClientDocumentObject { object: u64 now: ApplicationObject }
record ClientDocumentPanel { task: u64 procedure: option ProcedureState result: option u16 resources: list 64 ClientResource effects: list 128 OutboxEntry }
record ClientDocumentResult { task: u64 code: u16 }
record ClientDocumentEffect { proposal: u64 task: u64 effect: Effect description: Description }
record ClientDocumentOutbox { entry: OutboxEntry description: Description }
record ClientDocumentHold { task: u64 resources: list 64 ClientResource effects: list 128 OutboxEntry }
record ClientDocumentProject { project: u32 resources: list 64 ClientResource }
record ClientDocumentDeployment { outbox: list 128 OutboxEntry subject_limit: u32 staged_limit: u32 request_budget: DiagnosticAvailability system_last_response: DiagnosticAvailability }
enum ClientDocument { object: ClientDocumentObject, panel: ClientDocumentPanel, result: ClientDocumentResult, effect: ClientDocumentEffect, outbox: ClientDocumentOutbox, hold: ClientDocumentHold, project: ClientDocumentProject, deployment: ClientDocumentDeployment }
versioned record Request { project: u32 value: ApplicationRequest }
versioned record Outcome { value: ApplicationOutcome }
versioned record Document { value: ClientDocument }
record ReadValue { value: ClientDocument }
enum ReadResult { value: boxed ReadValue, unknown, not_allowed }
versioned record ReadAnswer { value: ReadResult }
versioned record Place { store_version: u16 party: u64 project: u32 item: u64 }
record FamilyNumber { value: u64 }
record FamilyProject { value: u32 }
enum FamilyProposer { task: FamilyNumber, party: FamilyNumber }
record FamilyProposalKey { proposer: FamilyProposer number: u64 }
enum FamilyScope { project: FamilyProject, deployment }
enum FamilyKind { item: FamilyNumber, panel: FamilyNumber, result: FamilyNumber, effect: FamilyProposalKey, owner_effect: FamilyNumber, outbox: FamilyNumber, hold: FamilyNumber, project: FamilyProject, deployment }
record FamilySubject { scope: FamilyScope kind: FamilyKind }
versioned record Subject { value: FamilySubject }
versioned record Read { value: FamilySubject }
enum ItemState { ready, held, ended }
record Item { project: u32 key: u64 revision: u64 state: ItemState value: u64 task: u64 second: option u64 proposals: list 128 FamilyProposalKey touchable: bool }
record Parameters { item: u64 revision: u64 value: u64 amendable: bool }
record PartDocument { subject: FamilySubject revision: u64 value: u64 parameters: option Parameters }
record FamilyRevision { item: u64 revision: u64 }
record FamilyConnectorDocument { subject: FamilySubject value: ClientDocument }
enum FamilyDocument { item: Item, part: PartDocument, connector: FamilyConnectorDocument }
versioned record FamilyDocumentRecord { value: FamilyDocument }
record FamilyConnectorAnswer { value: ApplicationOutcome }
enum FamilyAnswer { touched: FamilyRevision, moved: FamilyRevision, gone, connector: FamilyConnectorAnswer }
versioned record FamilyAnswerRecord { value: FamilyAnswer }
